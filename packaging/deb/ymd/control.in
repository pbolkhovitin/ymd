Source: ymd
Package: ymd
Version: @VERSION@
Section: sound
Priority: optional
Architecture: @ARCH@
Maintainer: Pavel Bolkhovitin <pbolkhovitin@yandex.ru>
Depends: @SHLIBS@, libsecret-tools, playerctl, dbus-user-session
